# Copiar a .env. No guardar credenciales reales en Git ni enviarlas al chat.
# Pegar solo la URL que ofrece Neon (sin psql ni comillas de un comando).
DATABASE_URL=
# Ejemplo: postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require&channel_binding=require

# Conexión a otra base/rama exclusivamente para pruebas; requiere crear test_<base>.
DATABASE_TEST_URL=

# Desarrollo local:
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# En desarrollo se genera una clave local si esta variable está vacía.
DJANGO_SECRET_KEY=
